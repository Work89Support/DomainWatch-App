# ---------- Database (PostgreSQL) ----------
# ตัวอย่างสำหรับ docker-compose ที่ให้มา (รันเครื่องตัวเอง)
DATABASE_URL="postgresql://domainwatch:domainwatch@localhost:5432/domainwatch?schema=public"

# ---------- Telegram แจ้งเตือน ----------
# สร้างบอทจาก @BotFather เพื่อได้ TOKEN
TELEGRAM_BOT_TOKEN=""
# chat id ของกลุ่ม/คนที่จะรับแจ้งเตือน (แยกด้วย , ได้)
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_IT_CHAT_ID=""
# ใช้ควบคุมเฉพาะ Recovery ของ LINE OA
# Recovery ของลิงก์ส่งอัตโนมัติเมื่อปิดเคสที่ยืนยันแล้วเสมอ
TELEGRAM_NOTIFY_RECOVERY="false"

# ---------- ระบบล็อกอิน ----------
# คีย์ลับสำหรับเซ็น session cookie (สุ่มยาว ๆ) เช่น `openssl rand -hex 32`
AUTH_SECRET="change-me-to-a-long-random-string"

# ---------- ความปลอดภัยของ endpoint เช็ค ----------
# ใส่ค่าลับ แล้วเวลาเรียก /api/check ต้องแนบ ?token=... หรือ header x-cron-token
CRON_SECRET="change-me"

# ---------- ตั้งค่าตัวเช็ค ----------
# ช้ากว่าค่านี้จะขึ้นสถานะ SLOW (มิลลิวินาที)
SLOW_RESPONSE_MS="5000"
# timeout สำหรับ GET และ HEAD (มิลลิวินาที) — รวมกันควรต่ำกว่า 30 วินาทีของ cron
CHECK_TIMEOUT_MS="12000"
CHECK_HEAD_TIMEOUT_MS="4000"
# งานอ่านเว็บทำพร้อมกันสูงได้เพราะเป็น network-bound; งานเขียน DB จำกัดแยกต่างหาก
CHECK_CONCURRENCY="160"
CHECK_WRITE_CONCURRENCY="24"
CHECK_OA_CONCURRENCY="80"
# ยืนยัน DOWN/UP กี่รอบติดต่อกัน เพื่อลดสถานะสลับไปมา
DOWN_CONFIRMATIONS="2"
RECOVERY_CONFIRMATIONS="2"
# URL ของระบบ (ใช้ในข้อความแจ้งเตือนให้กดเข้ามาแก้)
APP_BASE_URL="http://localhost:3000"
