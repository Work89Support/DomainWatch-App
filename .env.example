# ---------- Database (PostgreSQL) ----------
# ตัวอย่างสำหรับ docker-compose ที่ให้มา (รันเครื่องตัวเอง)
DATABASE_URL="postgresql://domainwatch:domainwatch@localhost:5432/domainwatch?schema=public"

# ---------- Telegram แจ้งเตือน ----------
# สร้างบอทจาก @BotFather เพื่อได้ TOKEN
TELEGRAM_BOT_TOKEN=""
# chat id ของกลุ่ม/คนที่จะรับแจ้งเตือน (แยกด้วย , ได้)
TELEGRAM_ADMIN_CHAT_ID=""
TELEGRAM_IT_CHAT_ID=""

# ---------- ความปลอดภัยของ endpoint เช็ค ----------
# ใส่ค่าลับ แล้วเวลาเรียก /api/check ต้องแนบ ?token=... หรือ header x-cron-token
CRON_SECRET="change-me"

# ---------- ตั้งค่าตัวเช็ค ----------
# timeout ต่อการยิง 1 ลิงก์ (มิลลิวินาที)
CHECK_TIMEOUT_MS="10000"
# URL ของระบบ (ใช้ในข้อความแจ้งเตือนให้กดเข้ามาแก้)
APP_BASE_URL="http://localhost:3000"
