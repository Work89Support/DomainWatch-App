// DomainWatch - Prisma schema (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// บริษัท/ลูกค้า — หนึ่งบริษัทมีได้หลายห้อง LINE และหลายลิงก์
model Company {
  id        String   @id @default(cuid())
  name      String
  note      String?
  isActive  Boolean  @default(true)
  // แจ้งเตือน Telegram แยกต่อบริษัท (ถ้าไม่ตั้ง = ใช้กลุ่มกลางจาก env)
  tgBotToken String?
  tgChatId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineGroups LineGroup[]
  links      Link[]
  userAssignments UserCompany[]

  @@index([isActive])
}

/// ห้อง LINE ภายใต้บริษัท (ที่มาของลิงก์)
model LineGroup {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String // ชื่อห้อง เช่น "ห้องแอดมิน A"
  note      String?
  isActive  Boolean  @default(true)

  // ---- ตรวจ LINE OA ด้วย Channel Access Token ----
  channelAccessToken String? // token ของ OA (ข้อมูลลับ)
  expectedOaName     String? // ชื่อ OA ที่คาดหวัง (ไว้เทียบว่าถูกเปลี่ยนไหม)
  oaStatus           String   @default("UNKNOWN") // OK | MISMATCH | NO_PICTURE | TOKEN_INVALID | ERROR | UNKNOWN
  oaDisplayName      String? // ชื่อจริงที่อ่านได้จาก LINE
  oaHasPicture       Boolean?
  oaLastCheckedAt    DateTime?
  oaError            String?

  createdAt DateTime @default(now())

  links Link[]

  @@index([companyId])
}

/// Master data ของลิงก์/หน้าเว็บที่ต้องเฝ้าดู
model Link {
  id          String   @id @default(cuid())
  companyId   String // สังกัดบริษัท
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lineGroupId String? // มาจากห้อง LINE ไหน (ถ้าระบุ)
  lineGroup   LineGroup? @relation(fields: [lineGroupId], references: [id], onDelete: SetNull)

  name        String // ชื่อที่พนักงานเข้าใจง่าย เช่น "หน้าเข้าเล่นหลัก"
  url         String // ลิงก์หลัก
  category    String?  @default("ทั่วไป") // หมวดหมู่ เช่น หน้าหลัก / ทางเข้า / โปรโมชัน
  backupUrl   String? // ลิงก์สำรอง (IT เตรียมไว้)
  note        String? // หมายเหตุ
  isActive    Boolean  @default(true) // เปิดการเฝ้าดูหรือไม่

  // สถานะล่าสุดจากการเช็ค
  lastStatus    LinkStatus @default(UNKNOWN)
  lastCheckedAt DateTime?
  lastHttpCode  Int?
  lastResponseMs Int?
  failureStreak  Int        @default(0) // จำนวนรอบที่ตรวจไม่ผ่านติดต่อกัน
  recoveryStreak Int        @default(0) // จำนวนรอบที่ตอบเร็วปกติติดต่อกัน

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  checkLogs CheckLog[]
  incidents Incident[]
  networkIncidents NetworkIncident[]

  @@index([companyId])
  @@index([lineGroupId])
  @@index([lastStatus])
  @@index([category])
}

/// โทรศัพท์ตรวจเครือข่ายมือถือ — token เก็บเฉพาะ hash และผูกได้ทีละเครื่อง
model MobileAgent {
  id              String   @id @default(cuid())
  name            String
  carrier         String   @default("TRUE")
  isActive        Boolean  @default(true)
  tokenHash       String?  @unique
  deviceId        String?  @unique
  deviceLabel     String?
  appVersion      String?
  networkType     String?
  reportedCarrier String?
  lastIp          String?
  enrolledAt      DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  enrollments     MobileEnrollment[]
  urlStatuses     MobileUrlStatus[]
  checkLogs       MobileCheckLog[]
  networkIncidents NetworkIncident[]

  @@index([isActive])
  @@index([lastSeenAt])
}

/// QR ผูกเครื่องแบบใช้ครั้งเดียว มีอายุสั้น และไม่เก็บรหัสจริง
model MobileEnrollment {
  id        String   @id @default(cuid())
  agentId   String
  agent     MobileAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  codeHash  String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([agentId, expiresAt])
}

/// ผลล่าสุดต่อ URL ของแต่ละเครื่อง ใช้ยืนยัน 2 รอบก่อนแจ้งเตือน
model MobileUrlStatus {
  id             String     @id @default(cuid())
  agentId        String
  agent          MobileAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  urlHash        String
  url            String
  status         LinkStatus @default(UNKNOWN)
  httpCode       Int?
  responseMs     Int?
  error          String?
  finalUrl       String?
  redirectCount Int        @default(0)
  redirectType  String?
  redirectChain Json?
  pageTitle      String?
  blockPageDetected Boolean @default(false)
  failureStreak  Int        @default(0)
  recoveryStreak Int        @default(0)
  checkedAt      DateTime
  updatedAt      DateTime   @updatedAt

  @@unique([agentId, urlHash])
  @@index([status, checkedAt])
}

/// บันทึกเฉพาะตอนสถานะเปลี่ยน เพื่อลดขนาดฐานข้อมูล
model MobileCheckLog {
  id         String     @id @default(cuid())
  agentId    String
  agent      MobileAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  urlHash    String
  url        String
  status     LinkStatus
  httpCode   Int?
  responseMs Int?
  error      String?
  finalUrl   String?
  redirectCount Int     @default(0)
  redirectType String?
  redirectChain Json?
  pageTitle  String?
  blockPageDetected Boolean @default(false)
  checkedAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([agentId, checkedAt])
  @@index([urlHash, checkedAt])
}

/// เหตุการณ์ที่ตรวจพบจากเครือข่ายซิม แยกจากเคส cloud เพื่อไม่ทำให้ dashboard ล่มผิด
model NetworkIncident {
  id         String          @id @default(cuid())
  agentId    String
  agent      MobileAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  linkId     String
  link       Link            @relation(fields: [linkId], references: [id], onDelete: Cascade)
  status     IncidentStatus  @default(OPEN)
  detectedAt DateTime        @default(now())
  resolvedAt DateTime?
  httpCode   Int?
  responseMs Int?
  error      String?
  finalUrl   String?
  redirectCount Int     @default(0)
  redirectType String?
  redirectChain Json?
  pageTitle  String?
  blockPageDetected Boolean @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([agentId, status])
  @@index([linkId, detectedAt])
}

enum LinkStatus {
  UP // ใช้งานได้
  SLOW // ใช้งานได้ แต่ตอบสนองช้าหรือกำลังรอยืนยันสถานะ
  DOWN // ใช้งานไม่ได้
  UNKNOWN // ยังไม่เคยเช็ค
}

/// บันทึกทุกครั้งที่บอทยิงเช็ค (ประวัติ)
model CheckLog {
  id         String     @id @default(cuid())
  linkId     String
  link       Link       @relation(fields: [linkId], references: [id], onDelete: Cascade)
  status     LinkStatus
  httpCode   Int?
  responseMs Int?
  error      String?
  checkedAt  DateTime   @default(now())

  @@index([linkId, checkedAt])
}

/// เหตุการณ์ลิงก์ล่ม 1 ครั้ง = 1 incident (เปิดตอนล่ม ปิดตอนกลับมาใช้ได้/แก้เสร็จ)
model Incident {
  id     String @id @default(cuid())
  linkId String
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  status IncidentStatus @default(OPEN)

  // ---- Timeline หลัก (ใช้คำนวณ KPI) ----
  detectedAt   DateTime  @default(now()) // บอทตรวจพบว่าล่ม + เริ่มใช้ไม่ได้ตอนไหน
  notifiedAt   DateTime? // ส่งแจ้งเตือนสำเร็จ
  adminAckAt   DateTime? // แอดมินรับทราบ (กดรับเรื่อง)
  adminUpdatedAt DateTime? // แอดมินอัพเดต/บันทึกลิงก์ใหม่ในระบบ = จบหน้าที่แอดมิน
  itAckAt      DateTime? // IT รับเรื่อง
  itResolvedAt DateTime? // IT ชี้แจงสาเหตุ + ให้ลิงก์สำรองแล้ว
  resolvedAt   DateTime? // ปิดเคส (ลิงก์กลับมาใช้ได้)

  // ---- รายละเอียด ----
  cause       String? // สาเหตุที่ IT ชี้แจง เช่น โดนบล็อกโดเมน
  newUrl      String? // ลิงก์ใหม่ที่แอดมินเปลี่ยน
  backupUrl   String? // ลิงก์สำรองที่ IT เตรียม
  adminUserId String?
  itUserId    String?
  adminUser   User?   @relation("AdminIncidents", fields: [adminUserId], references: [id])
  itUser      User?   @relation("ITIncidents", fields: [itUserId], references: [id])

  // ---- KPI ที่คำนวณไว้ (นาที) เพื่อ query เร็ว ----
  adminResponseMin Int? // detected/notified -> adminUpdated
  itResponseMin    Int? // detected/notified -> itResolved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([linkId, detectedAt])
}

enum IncidentStatus {
  OPEN // เพิ่งตรวจพบ ยังไม่มีใครจัดการ
  ADMIN_UPDATED // แอดมินอัพเดตลิงก์ในระบบแล้ว
  IT_RESOLVED // IT ชี้แจงสาเหตุ/ให้ลิงก์สำรองแล้ว
  CLOSED // ปิดเคส (ลิงก์กลับมาใช้ได้)
}

/// ผู้ใช้ระบบ (แอดมิน/ไอที) — ใช้ล็อกอินและผูก KPI รายคน
model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  adminIncidents Incident[] @relation("AdminIncidents")
  itIncidents    Incident[] @relation("ITIncidents")
  companyAssignments UserCompany[]
}

enum Role {
  ADMIN
  ADMIN_LEAD
  ADMIN_COMPANY
  IT
  MANAGEMENT
  SITE_STAFF
}

/// บริษัทที่มอบหมายให้ ADMIN_COMPANY — บทบาทอื่นไม่ใช้ขอบเขตนี้
model UserCompany {
  userId     String
  companyId  String
  assignedAt DateTime @default(now())

  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}
